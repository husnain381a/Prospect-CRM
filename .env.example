# Copy to .env.local. Demo remains separate and never sends.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Reserved for future server admin tooling; currently unused. Leave blank.
SUPABASE_SECRET_KEY=
# Direct Postgres or session-mode pooler connection for durable worker
DATABASE_URL=
APP_URL=http://localhost:3000
RESEND_API_KEY=
RESEND_FROM=
RESEND_WEBHOOK_SECRET=
UNSUBSCRIBE_SECRET=
# Licensed provider: HTTPS endpoint implementing docs/provider-contract.md
LICENSED_DISCOVERY_URL=
LICENSED_DISCOVERY_TOKEN=
# Optional audit. Explicit permission to crawl must be set per job.
WORKER_CONCURRENCY=2
WORKER_POLL_MS=2500
# Official automation channels. Set on both web and worker services.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_GRAPH_VERSION=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Direct Google Places API (New). Server-only key, shared by web and worker.
GOOGLE_PLACES_API_KEY=
# Separate export / Google-data text-to-speech settings; default off.
GOOGLE_PLACES_EXPORT_ALLOWED=false
GOOGLE_PLACES_VOICE_LICENSE_ALLOWED=false
# Estimated USD per search request for your selected fields/SKU; not a provider billing cap.
GOOGLE_PLACES_REQUEST_COST=

# Keep these false until you explicitly activate the retained channels.
WHATSAPP_ENABLED=false
AUTOMATED_CALLS_ENABLED=false
