    "clsx": "2.1.1",
    "ipaddr.js": "2.5.0",
    "lucide-react": "1.61.0",
    "next": "16.4.2",
    "papaparse": "5.7.0",
    "postgres": "3.4.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.10.1",
